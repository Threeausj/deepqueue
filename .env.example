# Replace with the real domain pointed at the public host; no trailing /api or path.
DEEPQUEUE_PUBLIC_URL=https://queue.example.com
DEEPQUEUE_PORT=8765
DEEPQUEUE_IMAGE=deepqueue:local
CODEX_VERSION=0.153.4

# Start with scheduling stopped. Start it from General Settings after configuring
# Codex and execution servers. Set true only to opt into starting on every restart.
DEEPQUEUE_START_SCHEDULER=false
